# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Email notifications (Resend)
RESEND_API_KEY=your_resend_api_key

# Supabase admin (for fetching user emails in notify API)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cron job auth for /api/auto-complete (Vercel Cron) — REQUIRED in production
CRON_SECRET=your_random_cron_secret

# Payments (Pro subscription, avatar frame) — keep false until Stripe/webhook is live
PAYMENTS_ENABLED=false
