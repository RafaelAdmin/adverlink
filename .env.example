# Public site URL (no trailing slash). Used in auth email redirects.
# Production: https://www.adverlink.am
NEXT_PUBLIC_APP_URL=https://www.adverlink.am

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=adverlink_bot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=adverlink_bot
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret
# Webhook URL must be the canonical URL without redirect (www, not a 301/302 hop).
TELEGRAM_WEBHOOK_URL=https://www.adverlink.am/api/telegram/webhook

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Email notifications (Resend)
RESEND_API_KEY=your_resend_api_key

# Supabase admin (for fetching user emails in notify API)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cron job auth for /api/auto-complete (Vercel Cron) — REQUIRED in production
CRON_SECRET=your_random_cron_secret

# Simulated deal payments (Beta) — server gate for /api/deals/[id]/payment/simulated
SIMULATED_PAYMENTS_ENABLED=true
NEXT_PUBLIC_SIMULATED_PAYMENTS_ENABLED=true

# Payments (Pro subscription, avatar frame) — keep false until Stripe/webhook is live
PAYMENTS_ENABLED=false

# E2E tests (optional — authenticated Playwright flows)
# E2E_TEST_EMAIL=
# E2E_TEST_PASSWORD=
# E2E_TEST_IS_ADMIN=false
